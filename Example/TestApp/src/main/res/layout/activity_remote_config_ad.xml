<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Remote Config Banner (separate screen)"
            android:textColor="#212121"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:minHeight="50dp"
            android:background="@drawable/bg_ad_slot" />

        <!-- Directly under the ad: leaving is half of the test, and a device without a visible
             back gesture (or a tester who does not know it) should not have to hunt for it. -->
        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Close (back to Remote Config)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Navigate back to the Remote Config tab to verify its banners reload, and that this screen's banner pauses/reloads on screen changes."
            android:textColor="#616161"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
